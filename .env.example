OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# "ollama" (default, 100% local) or another provider tradingagents' LLM
# factory supports (e.g. "google" for Gemini). LLM_MODEL is only used when
# LLM_PROVIDER is not "ollama".
LLM_PROVIDER=ollama
LLM_MODEL=
BRAPI_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
DATABASE_URL=sqlite:///data/trading.db
TRADING_MODE=PAPER
ANALYSIS_TIMEOUT_SECONDS=1500
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
